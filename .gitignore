# ============================================================
#  .gitignore  —  project root: /home/ubuntu/pytact
#  원칙: 소스/설정/자산은 추적, 대용량 생성물·환경은 제외
# ============================================================

# ── 파이썬 가상환경 (수 GB, 절대 커밋 금지) ──
.venv/
venv/
env/

# ── 파이썬 캐시 / 빌드 ──
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# ── 컴파일된 네이티브 바이너리 (소스에서 재빌드됨) ──
#    mjenv.so, libtact.so 등
#    특정 .so를 꼭 추적하려면:  git add -f 경로/파일.so
*.so
*.o
*.a
*.dylib
*.dll
native/lib/
native/demos/basic/bin-test

# ── Agent/assistant 로컬 메타데이터 (컴퓨터마다 다름) ──
.agents/
.codex/
.claude/

# ── Agent/assistant 문서 ──
AGENTS.md
CLAUDE.md

# ── 로컬 개발 자료 ──
local/

# ── 임시 작업 디렉터리 ──
_/

# ── OS / 에디터 잡파일 ──
.DS_Store
*.swp
*~
