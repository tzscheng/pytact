<mujoco>
  
  <compiler coordinate="local"/>
  <option timestep="0.001" iterations="100" tolerance="1e-10" solver="Newton" gravity="0 0 -9.81"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="0.6 0.8 1" width="256" height="256"/>
  </asset>

  <worldbody>
    <light pos="0 1 1" dir="0 -1 -1" diffuse="1 1 1"/>
    <body>
      <joint name="joint1" type="hinge" pos="0 0 0" axis="0 1 0" frictionloss="0.5"/>
      <geom type="capsule" fromto="0 0 0  0 0 0.5" size="0.05" mass="1" rgba="0.3 0.3 0.5 0.5"/>
      <body>
	<joint name="joint2" type="hinge" pos="0 0 0.5" axis="0 1 0" frictionloss="0.5"/>
	<geom type="capsule" fromto="0 0 0.5  0 0 1" size="0.05" mass="1" rgba="0.3 0.3 0.5 0.5"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor joint="joint1"/>
    <motor joint="joint2"/>
  </actuator>
	   
  <sensor>
    <jointpos joint="joint1"/>
    <jointpos joint="joint2"/>
    <jointvel joint="joint1"/>
    <jointvel joint="joint2"/>
  </sensor>
  
</mujoco>
