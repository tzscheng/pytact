<mujoco>
  <compiler coordinate="local" angle="degree"/>
  <option timestep="0.001" iterations="100" tolerance="1e-10" solver="Newton" gravity="0 0 -9.81"/>

  <visual>
    <quality shadowsize="2048" offsamples="4"/>
    <headlight ambient="0.5 0.5 0.5"  diffuse="0.4 0.4 0.4" specular="0.5 0.5 0.5"/>
  </visual>
  
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.8 0.8 0.8" rgb2="0.8 0.8 0.8" width="512" height="512"/>
  </asset>
  
  <worldbody>
    <light pos="0 1 1" dir="0 -1 -1" diffuse="1 1 1"/> 
    <body>
      <joint name="joint1" type="hinge" pos="0 -0.1 0" axis="0 -1 0" frictionloss="0.5" damping="0.5"/>
      <geom type="cylinder" pos="0 -0.1 0" euler="90 0 0" size="0.03 0.04" mass="1" rgba="0.5 0.5 0.5 1"/>
      <body>
	<joint name="joint2" type="hinge" pos="0 -0.2 0" axis="-1 0 0" frictionloss="0.5" damping="0.5"/>
	<geom type="cylinder" pos="0 -0.2 0" euler="0 90 0" size="0.03 0.025" mass="0" rgba="0.5 0.5 0.5 1"/>
	<geom type="cylinder" fromto="0 -0.2 -0.05  0 -0.2 -0.45" size="0.02" mass="1" rgba="0.3 0.3 0.5 1"/>
	<body>
	  <joint name="joint3" type="hinge" pos="0 -0.2 -0.5" axis="0 -1 0" frictionloss="0.5" damping="0.5"/>
	  <geom type="cylinder" pos="0 -0.2 -0.5" euler="90 0 0" size="0.03 0.025" mass="0" rgba="0.5 0.5 0.5 1"/>
	  <geom type="cylinder" fromto="0 -0.2 -0.55  0 -0.2 -0.95" size="0.02" mass="1" rgba="0.3 0.3 0.5 1"/>
	  <body>
 	    <geom type="sphere" pos="0 -0.2 -1.0" size="0.025" mass="0" rgba="0.5 0.3 0.3 1"/>
	  </body>
	</body>
      </body>
    </body>
  </worldbody>
  
  <actuator>
    <motor name="motor1" joint="joint1" />
    <motor name="motor2" joint="joint2" />
    <motor name="motor3" joint="joint3" />
  </actuator>
  
  <sensor>
    <jointpos joint="joint1"/>
    <jointpos joint="joint2"/>
    <jointpos joint="joint3"/>

    <jointvel joint="joint1"/>
    <jointvel joint="joint2"/>
    <jointvel joint="joint3"/>
  </sensor>
</mujoco>
