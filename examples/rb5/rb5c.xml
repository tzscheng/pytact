		</body>
	      </body>
	    </body>
	  </body>
	</body>
      </body>
    </body>
    
  </worldbody>
  
    
  <actuator>
    <!-- motor: feedforward torque channel (ctrl = tau, paired 1:1 with position below) -->
    <motor gear="1" joint="rb5.joint1" />
    <motor gear="1" joint="rb5.joint2" />
    <motor gear="1" joint="rb5.joint3" />
    <motor gear="1" joint="rb5.joint4" />
    <motor gear="1" joint="rb5.joint5" />
    <motor gear="1" joint="rb5.joint6" />
    <position joint="rb5.joint1" kp="1000" kv="20"/>
    <position joint="rb5.joint2" kp="1000" kv="20"/>
    <position joint="rb5.joint3" kp="1000" kv="20"/>
    <position joint="rb5.joint4" kp="1000" kv="20"/>
    <position joint="rb5.joint5" kp="1000" kv="20"/>
    <position joint="rb5.joint6" kp="1000" kv="20"/>
  </actuator>

  <sensor>            
    <jointpos joint="rb5.joint1"/>
    <jointpos joint="rb5.joint2"/>
    <jointpos joint="rb5.joint3"/>
    <jointpos joint="rb5.joint4"/>
    <jointpos joint="rb5.joint5"/>
    <jointpos joint="rb5.joint6"/>

    <jointvel joint="rb5.joint1"/>
    <jointvel joint="rb5.joint2"/>
    <jointvel joint="rb5.joint3"/>
    <jointvel joint="rb5.joint4"/>
    <jointvel joint="rb5.joint5"/>
    <jointvel joint="rb5.joint6"/>

    <torque site="sensor"/>
    <force site="sensor"/>
    
  </sensor>

</mujoco>
