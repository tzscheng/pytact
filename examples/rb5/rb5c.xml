<mujoco>
  <compiler coordinate="local" angle="degree"/>
  <default class="main">
    <geom rgba="0.7 0.7 0.7 1.0"/>
    <joint frictionloss="0.1" damping="0.5"/>
  </default>
  
  <option timestep="0.001" iterations="100" tolerance="1e-10" solver="Newton" gravity="0 0 -9.81"/>
  <!--<visual> <quality shadowsize="4096"/>  </visual> -->

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="256" height="256"/>
  </asset>
  
  <worldbody>
    <light pos="0 3 3" dir="0 -1 -1" diffuse="1 1 1" castshadow="false"/>

    <body>
      <geom name="base" type="cylinder" fromto="0 0 0  0 0 0.045" size="0.095"/>
      <inertial pos="0 0 0.02" mass="1" diaginertia="0.005 0.005 0.005"/>
      <body>
	<joint name="rb5.joint1" type="hinge" pos="0 0 0" axis="0 0 1"/>
	<geom type="cylinder" fromto="0 0 0.05  0 0 0.24" size="0.07"/>
	<inertial pos="0 0 0.1692" mass="1" diaginertia="0.01 0.01 0.01"/>
	<body>
	  <joint name="rb5.joint2" type="hinge" pos="0 0 0.1692" axis="0 1 0"/>
	  <geom type="cylinder" fromto="0 -0.08 0.1692  0 -0.22 0.1692" size="0.05"/>
	  <geom type="cylinder" fromto="0 -0.1484 0.225 0 -0.1484 0.55" size="0.05"/>
	  <geom type="cylinder" fromto="0 -0.08 0.5942  0 -0.22 0.5942" size="0.045"/>
	  <inertial pos="0 -0.1484 0.3817" mass="2" diaginertia="0.01 0.01 0.01"/>
	  <body>
	    <joint name="rb5.joint3" type="hinge" pos="0 0 0.5942" axis="0 1 0"/>
	    <geom type="cylinder" fromto="0 0.07 0.5942  0 -0.07 0.5942" size="0.045"/>
	    <geom type="cylinder" fromto="0 0 0.64  0 0 0.94" size="0.04"/>
	    <geom type="cylinder" fromto="0 0.06 0.9862  0 -0.06 0.9862" size="0.04"/>
	    <inertial pos="0 0 0.7902" mass="1.5" diaginertia="0.01 0.01 0.01"/>
	    <body>
	      <joint name="rb5.joint4" type="hinge" pos="0 0 0.9862" axis="0 1 0"/>
	      <geom type="cylinder" fromto="0 -0.1107 0.94  0 -0.1107 1.05" size="0.04"/>
	      <inertial pos="0 -0.1107 0.9862" mass="0.5" diaginertia="0.005 0.005 0.005"/>
	      <body>
		<joint name="rb5.joint5" type="hinge" pos="0 -0.1107 0.9" axis="0 0 1"/>
		<geom type="cylinder" fromto="0 -0.06 1.0969  0 -0.16 1.0969" size="0.04"/>
		<inertial pos="0 -0.1107 1.0969" mass="0.5" diaginertia="0.005 0.005 0.005"/>
		<body>
		  <joint name="rb5.joint6" type="hinge" pos="0 -0.1107 1.0969" axis="0 1 0"/>
		  <geom type="cylinder" fromto="0 -0.17 1.0969  0 -0.20 1.0969" size="0.04"/>
		  <inertial pos="0 -0.1580 1.0969" mass="0.1" diaginertia="0.005 0.005 0.005"/>

		  <body>
		    <geom type="cylinder" fromto="0 -0.21 1.0969  0 -0.25 1.0969" size="0.04" rgba="0.3 0.3 0.8 1.0"/>
		    <geom type="sphere" pos="0 -0.30 1.0969" size = "0.03" rgba="0.8 0.3 0.3 1.0"/>
