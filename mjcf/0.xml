<mujoco>
  <!-- Shared MuJoCo environment: infinite checker ground plane.
       Loaded by `start -e0 -m` (robot xml is the parent spec; this file is
       attached into it via mjSpec, so <option>/<visual> here would be ignored
       — keep environment files to assets + worldbody only).
       Floor convention: group="1" = terrain (raycast/height_scan visibility;
       robot geoms live in group 0). -->
  <asset>
    <texture name="texplane" type="2d" builtin="checker" rgb1="1 1 1" rgb2="1 1 1" width="512" height="512" mark="cross" markrgb="0 0 0"/>
    <material name="matplane" reflectance="0.0" texture="texplane" texrepeat="1 1" texuniform="true"/>
  </asset>

  <worldbody>
    <geom group="1" name="floor" pos="0 0 0" size="0 0 0.25" type="plane" material="matplane" condim="3"/>
  </worldbody>
</mujoco>
