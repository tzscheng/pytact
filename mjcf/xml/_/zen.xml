<mujoco>
  <compiler coordinate="local" angle="degree"/>
  <option timestep="0.001" iterations="100" tolerance="1e-10" solver="Newton" integrator="implicit" gravity="0 0 -9.81"/>
  
  <visual>
    <map stiffness="2" stiffnessrot="100"/>
    <rgba haze="0.5 0.5 0.5 1"/>
    <quality shadowsize="2048" offsamples="16"/>
    <headlight ambient="0.5 0.5 0.5"  diffuse="0.4 0.4 0.4" specular="0.5 0.5 0.5"/>
  </visual>
 
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.5 0.5 0.5" rgb2="0.5 0.5 0.5" width="512" height="512"/>
  </asset>
  
  <worldbody>
    <light mode="trackcom" target="model" directional="false" diffuse="0.3 0.3 0.3" specular="0.5 0.5 0.5" pos="4 0 4.0" dir="-1 0 -1" castshadow="true"/>
    
    <body name="model">
      <freejoint/>
      <!--<geom type="box" pos="0 0 1.5" size="0.25 0.15 0.15" mass="10" rgba="0.3 0.3 0.5 1"/>-->
      <geom type="box" pos="0 0 1.2" size="0.25 0.15 0.06" mass="10" rgba="0.3 0.3 0.6 1" contype="1" conaffinity="2"/>
      
      <site name="ahrs" pos="0 0 1.2" euler="0 0 0" type="sphere" size="0.01"/>
      <site name="base" pos="0 0 1.05" euler="0 0 0" type="sphere" size="0.01"/>

      <!--<site name="ahrs" pos="0 0 1.05" euler="0 0 0" type="sphere" size="0.01"/>-->

      
      <body pos="0 0.10 1.05">
	<joint name="joint1" type="hinge" pos="0 0 0" axis="0 -1 0" frictionloss="0.2" damping="0.5"/>
	<geom type="cylinder" fromto="0 -0.08 0 0 0.01 0" size="0.05" euler="90 0 0" mass="1.5" rgba="0.8 0.8 0.2 1" contype="1" conaffinity="2"/>
	<body>
	  <joint name="joint2" type="hinge" pos="0 0.10 0" axis="1 0 0" frictionloss="0.2" damping="0.5"/>
	  <geom type="cylinder" pos="0 0.10 0" euler="0 90 0" size="0.045 0.05" mass="1.5" rgba="0.6 0.6 0.6 1" contype="1" conaffinity="2"/>
	  <body>
	    <joint name="joint3" type="hinge" pos="0 0.10 -0.10" axis="0 0 1" frictionloss="0.2" damping="0.5"/>
	    <geom type="cylinder" fromto="0 0.10 -0.06   0 0.10 -0.15" size="0.04" mass="1.5" rgba="0.6 0.6 0.6 1" contype="1" conaffinity="2"/>
	    <geom type="cylinder" fromto="0 0.10 -0.16  0 0.10 -0.44" size="0.04" mass="1.0" rgba="0.6 0.6 0.6 1" contype="1" conaffinity="2"/>
	    <body>
	      <joint name="joint4" type="hinge" pos="0 0.10 -0.5" axis="0 -1 0" frictionloss="0.2" damping="0.5"/>
	      <geom type="cylinder" pos="0 0.10 -0.5" euler="90 0 0" size="0.04 0.04" mass="1.5" rgba="0.6 0.6 0.6 1" contype="1" conaffinity="2"/>
	      <geom type="cylinder" fromto="0 0.10 -0.56  0 0.10 -0.94" size="0.015" mass="0.5" rgba="0.6 0.6 0.6 1" contype="0" conaffinity="0"/>
	      <body>
		<joint name="joint5" type="hinge" pos="0 0.10 -1.0" axis="0 -1 0" frictionloss="0.2" damping="0.5"/>
		<geom type="cylinder" pos="0 0.10 -1.0" euler="90 0 0" size="0.03 0.04" mass="1.0" rgba="0.6 0.6 0.6 1" contype="0" conaffinity="0"/>
		<body>
		  <joint name="joint6" type="hinge" pos="0 0.10 -1.0" axis="1 0 0" frictionloss="0.2" damping="0.5"/>
		  <geom type="cylinder" pos="0 0.10 -1.0" euler="0 90 0" size="0.03 0.06" mass="0.75" rgba="0.6 0.6 0.6 1" contype="0" conaffinity="0"/>
		  <body>
		    <geom type="box" pos="0 0.10 -1.04" size="0.12 0.07 0.01" mass="0.70" rgba="0.3 0.3 0.6 1" contype="0" conaffinity="0"/>
		    <body>
 		      <geom type="box" pos="0 0.10 -1.04" size="0.12 0.07 0.01" mass="0.05" rgba="0.3 0.3 0.6 1" friction="1 0.005 0.0001" contype="1" conaffinity="2"/>
		      <site name="endtip1" pos="0 0.10 -1.0" euler="0 0 0" type="sphere" size="0.01"/>
		    </body>
		  </body>
		</body>
	      </body>
	    </body>
	  </body>
	</body>
      </body>

      <body pos="0 -0.10 1.05">
	<joint name="joint7" type="hinge" pos="0 0 0" axis="0 -1 0" frictionloss="0.2" damping="0.5"/>
	<geom type="cylinder" fromto="0 -0.01 0 0 0.08 0" size="0.05" euler="90 0 0" mass="1.5" rgba="0.8 0.8 0.2 1" contype="1" conaffinity="2"/>
	<body>
	  <joint name="joint8" type="hinge" pos="0 -0.10 0" axis="-1 0 0" frictionloss="0.2" damping="0.5"/>
	  <geom type="cylinder" pos="0 -0.10 0" euler="0 90 0" size="0.045 0.05" mass="1.5" rgba="0.6 0.6 0.6 1" contype="1" conaffinity="2"/>
	  <body>
	    <joint name="joint9" type="hinge" pos="0 -0.10 -0.10" axis="0 0 -1" frictionloss="0.2" damping="0.5"/>
	    <geom type="cylinder" fromto="0 -0.10 -0.06  0 -0.10 -0.15" size="0.04" mass="1.5" rgba="0.6 0.6 0.6 1" contype="1" conaffinity="2"/>
	    <geom type="cylinder" fromto="0 -0.10 -0.16  0 -0.10 -0.44" size="0.04" mass="1.0" rgba="0.6 0.6 0.6 1" contype="1" conaffinity="2"/>
	    <body>
	      <joint name="joint10" type="hinge" pos="0 -0.10 -0.5" axis="0 -1 0" frictionloss="0.2" damping="0.5"/>
	      <geom type="cylinder" pos="0 -0.10 -0.5" euler="90 0 0" size="0.04 0.04" mass="1.5" rgba="0.6 0.6 0.6 1" contype="1" conaffinity="2"/>
	      <geom type="cylinder" fromto="0 -0.10 -0.56  0 -0.10 -0.94" size="0.015" mass="0.5" rgba="0.6 0.6 0.6 1" contype="0" conaffinity="0"/>
	      <body>
		<joint name="joint11" type="hinge" pos="0 -0.10 -1.0" axis="0 -1 0" frictionloss="0.2" damping="0.5"/>
		<geom type="cylinder" pos="0 -0.10 -1.0" euler="90 0 0" size="0.03 0.04" mass="1.0" rgba="0.6 0.6 0.6 1" contype="0" conaffinity="0"/>
		<body>
		  <joint name="joint12" type="hinge" pos="0 -0.10 -1.0" axis="-1 0 0" frictionloss="0.2" damping="0.5"/>
		  <geom type="cylinder" pos="0 -0.10 -1.0" euler="0 90 0" size="0.03 0.06" mass="0.75" rgba="0.6 0.6 0.6 1" contype="0" conaffinity="0"/>
		  <body>
		    <geom type="box" pos="0 -0.10 -1.04" size="0.12 0.07 0.01" mass="0.70" rgba="0.3 0.3 0.6 1" contype="0" conaffinity="0"/>
		    <body>
		      <geom type="box" pos="0 -0.10 -1.04" size="0.12 0.07 0.01" mass="0.05" rgba="0.3 0.3 0.6 1" friction="1 0.005 0.0001" contype="1" conaffinity="2"/>
		      <site name="endtip2" pos="0 -0.10 -1.0" euler="0 0 0" type="sphere" size="0.01"/>
		    </body>
		  </body>	  
		</body>
	      </body>
	    </body>
	  </body>
	</body>
      </body>
      
    </body>
    
  </worldbody>

  <equality>
    <weld body1="model" active="true"/>
  </equality>

  
  <actuator>
    <!-- motor: feedforward torque channel (ctrl = tau, paired 1:1 with position below) -->
    <motor joint="joint1" />
    <motor joint="joint2" />
    <motor joint="joint3" />
    <motor joint="joint4" />
    <motor joint="joint5" />
    <motor joint="joint6" />
    <motor joint="joint7" />
    <motor joint="joint8" />
    <motor joint="joint9" />
    <motor joint="joint10" />
    <motor joint="joint11" />
    <motor joint="joint12" />

    <!-- position: implicit-PD channel (ctrl = q_ref). kp/kv match zen.py's implicit_pd
         path Kp_j=1000, Kd_j=5. mjcore.cpp toggles these gains to 0 when agent.q_ref is
         None (e.g., walking '1' state) so walk1's task-PD torques aren't fought by joint-PD. -->
    <position joint="joint1"  kp="1000" kv="20"/>
    <position joint="joint2"  kp="1000" kv="20"/>
    <position joint="joint3"  kp="1000" kv="20"/>
    <position joint="joint4"  kp="1000" kv="20"/>
    <position joint="joint5"  kp="1000" kv="20"/>
    <position joint="joint6"  kp="1000" kv="20"/>
    <position joint="joint7"  kp="1000" kv="20"/>
    <position joint="joint8"  kp="1000" kv="20"/>
    <position joint="joint9"  kp="1000" kv="20"/>
    <position joint="joint10" kp="1000" kv="20"/>
    <position joint="joint11" kp="1000" kv="20"/>
    <position joint="joint12" kp="1000" kv="20"/>

  </actuator>
  
  <sensor>
    <jointpos joint="joint1"/>
    <jointpos joint="joint2"/>
    <jointpos joint="joint3"/>
    <jointpos joint="joint4"/>
    <jointpos joint="joint5"/>
    <jointpos joint="joint6"/>
    <jointpos joint="joint7"/>
    <jointpos joint="joint8"/>
    <jointpos joint="joint9"/>
    <jointpos joint="joint10"/>
    <jointpos joint="joint11"/>
    <jointpos joint="joint12"/>

    
    <jointvel joint="joint1"/>
    <jointvel joint="joint2"/>
    <jointvel joint="joint3"/>
    <jointvel joint="joint4"/>
    <jointvel joint="joint5"/>
    <jointvel joint="joint6"/>
    <jointvel joint="joint7"/>
    <jointvel joint="joint8"/>
    <jointvel joint="joint9"/>
    <jointvel joint="joint10"/>
    <jointvel joint="joint11"/>
    <jointvel joint="joint12"/>

    
    <force  site="endtip1"/>
    <torque site="endtip1"/>
    
    <force  site="endtip2"/>
    <torque site="endtip2"/>
    
    <framequat objtype="site" objname="ahrs"/>
    <accelerometer site="ahrs"/>
    <gyro site="ahrs"/>
    
    <framelinvel objtype="site" objname="ahrs"/>
    <framepos objtype="site" objname="base"/>

  </sensor>
</mujoco>
